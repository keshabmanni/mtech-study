/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mtech",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker.ts",
  "vars": {
    "UPLOADS_MAX_FILES": "5",
  },
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mtech-study",
      "database_id": "9a8687ab-098e-418f-a410-1b54a011e45c",
    },
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "mtech-study-files",
    },
  ],
  "ratelimits": [
    {
      "name": "MAIN_PAGE_LIMITER",
      "namespace_id": "2026110701",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
    {
      "name": "UPLOAD_API_LIMITER",
      "namespace_id": "2026110702",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
    {
      "name": "UPLOAD_DOWNLOAD_LIMITER",
      "namespace_id": "2026110703",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
  ],
  "triggers": {
    "crons": ["*/10 * * * *"],
  },
}
